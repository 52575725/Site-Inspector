# Google Cloud credentials
SI_GOOGLE_CREDENTIALS_PATH=C:/path/to/google-credentials.json
SI_GSC_PROPERTY=sc-domain:helinsilver.com
SI_GA4_PROPERTY_ID=properties/123456789

# Ollama
SI_OLLAMA_BASE_URL=http://localhost:11434
SI_OLLAMA_MODEL=llama3.2
SI_OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional DeepSeek generation
SI_DEEPSEEK_API_KEY=
SI_DEEPSEEK_MODEL=deepseek-chat

# Article images: search providers first, AI fallback disabled by default.
SI_UNSPLASH_API_KEY=
SI_PEXELS_API_KEY=
SI_PIXABAY_API_KEY=
SI_IMAGE_GENERATION_ENABLED=false
SI_OPENAI_API_KEY=
SI_IMAGE_GENERATION_MODEL=gpt-image-2
SI_ARTICLE_IMAGE_COUNT=4

# Source repository. Keep writes disabled until the target and credentials
# have been verified in a disposable test repository.
SI_SOURCE_TYPE=local
SI_SOURCE_LOCAL_PATH=data/site_sources/helinsilver
SI_WEB_ALLOW_REPO_WRITES=false
SI_WEB_MAX_ACTIVE_SCANS=1

# Git
SI_GIT_AUTHOR_NAME=Site Inspector Bot
SI_GIT_AUTHOR_EMAIL=bot@site-inspector.local
SI_GIT_PLATFORM=github
SI_GIT_AUTO_MERGE=false

# Reporting
SI_REPORT_RECIPIENTS=[]
SI_SMTP_HOST=
SI_SMTP_PORT=587

# Scheduler
SI_DAILY_SCAN_TIME=02:00
SI_WEEKLY_REPORT_DAY=mon
SI_WEEKLY_REPORT_TIME=08:00
